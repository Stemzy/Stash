{
  "name": "stash",
  "productName": "Stash",
  "version": "0.1.5",
  "description": "Stash: download videos and music, keep them in your own library, and find their key and BPM.",
  "main": "./out/main/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "postinstall": "install-electron",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "test": "tsx scripts/tests/mapInfo.test.ts && tsx scripts/tests/audio.test.ts && tsx scripts/tests/video.test.ts && tsx scripts/tests/queue.test.ts && tsx scripts/tests/links.test.ts && tsx scripts/tests/key.test.ts && tsx scripts/tests/prep.test.ts && tsx scripts/tests/tempo.test.ts && tsx scripts/tests/folders.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
